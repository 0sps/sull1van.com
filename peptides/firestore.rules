rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == "sspsful@gmail.com";
    }

    function hasOwnerEnvelope(userId) {
      return request.resource.data.ownerUid == userId
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.schemaVersion == 3;
    }

    function validRootKeys() {
      return request.resource.data.keys().hasOnly([
        "schemaVersion",
        "ownerUid",
        "ownerEmail",
        "updatedAt",
        "app"
      ]);
    }

    function validRecordKeys() {
      return request.resource.data.keys().hasOnly([
        "schemaVersion",
        "ownerUid",
        "ownerEmail",
        "createdAt",
        "updatedAt",
        "id",
        "name",
        "peptideMg",
        "waterMl",
        "targetDose",
        "doseUnit",
        "syringeUnits",
        "frequency",
        "time",
        "startDate",
        "duration",
        "type",
        "title",
        "value",
        "timestamp",
        "protocolName",
        "percent",
        "status",
        "color",
        "text",
        "date"
      ]);
    }

    match /peptides/{userId} {
      allow read: if isAllowedOwner(userId);
      allow create, update: if isAllowedOwner(userId)
        && hasOwnerEnvelope(userId)
        && validRootKeys();
      allow delete: if isAllowedOwner(userId);

      match /protocols/{recordId} {
        allow read: if isAllowedOwner(userId);
        allow create, update: if isAllowedOwner(userId)
          && hasOwnerEnvelope(userId)
          && request.resource.data.id == recordId
          && validRecordKeys();
        allow delete: if isAllowedOwner(userId);
      }

      match /logs/{recordId} {
        allow read: if isAllowedOwner(userId);
        allow create, update: if isAllowedOwner(userId)
          && hasOwnerEnvelope(userId)
          && request.resource.data.id == recordId
          && validRecordKeys();
        allow delete: if isAllowedOwner(userId);
      }

      match /labs/{recordId} {
        allow read: if isAllowedOwner(userId);
        allow create, update: if isAllowedOwner(userId)
          && hasOwnerEnvelope(userId)
          && request.resource.data.id == recordId
          && validRecordKeys();
        allow delete: if isAllowedOwner(userId);
      }

      match /journal/{recordId} {
        allow read: if isAllowedOwner(userId);
        allow create, update: if isAllowedOwner(userId)
          && hasOwnerEnvelope(userId)
          && request.resource.data.id == recordId
          && validRecordKeys();
        allow delete: if isAllowedOwner(userId);
      }
    }
  }
}
